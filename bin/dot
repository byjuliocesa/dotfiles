#!/usr/bin/env bash
set -euo pipefail

DOTFILES="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

# shellcheck source=../scripts/lib.sh
source "$DOTFILES/scripts/lib.sh"

usage() {
  cat <<USAGE
Usage: dot <command>

  sync              pull the repo and relink every config
  save "msg"        commit everything and push
  edit <name>       open the config whose path matches <name>
  doctor [links]    report broken links and package drift
  pkg add <pkg>     install a package and record it in packages/
  pkg drift         list installed packages missing from packages/
  pkg ignore <pkg>  stop reporting a package as drift
  secret ...        init | add <file> | restore
USAGE
}

manifests() {
  printf '%s\n' "$DOTFILES/links.txt"
  [[ -d "$HOME/.codex" ]] && printf '%s\n' "$DOTFILES/ai/links.txt"
  return 0
}

cmd_sync() {
  git -C "$DOTFILES" pull --rebase --autostash
  local manifest
  while read -r manifest; do
    "$DOTFILES/scripts/links.sh" "$manifest"
  done < <(manifests)
}

cmd_save() {
  [[ $# -gt 0 ]] || die 'Usage: dot save "message"'
  git -C "$DOTFILES" add -A
  git -C "$DOTFILES" commit -m "$*"
  git -C "$DOTFILES" push
}

cmd_edit() {
  [[ $# -eq 1 ]] || die "Usage: dot edit <name>"

  local -a matches
  mapfile -t matches < <(grep -Ev '^\s*(#|$)' "$DOTFILES/links.txt" | awk '{print $1}' | grep -i -- "$1" || true)

  local pick
  case ${#matches[@]} in
    0) die "No config matches '$1'" ;;
    1) pick="${matches[0]}" ;;
    *)
      command_exists fzf || die "Several matches: ${matches[*]}"
      pick="$(printf '%s\n' "${matches[@]}" | fzf --prompt 'dot edit> ')" || exit 0
      ;;
  esac

  "${EDITOR:-nvim}" "$DOTFILES/$pick"
}

listed_packages() {
  grep -hEv '^\s*(#|$)' "$DOTFILES"/packages/{arch,aur,ignore}.txt | sort -u
}

drift_packages() {
  comm -23 <(pacman -Qqe | sort) <(listed_packages)
}

cmd_pkg_add() {
  [[ $# -gt 0 ]] || die "Usage: dot pkg add <package>..."

  local package list helper
  for package in "$@"; do
    if pacman -Si "$package" >/dev/null 2>&1; then
      run_sudo pacman -S --needed --noconfirm "$package"
      list=arch
    else
      helper="$(command -v yay || command -v paru)" || die "$package is not in pacman and no AUR helper is installed"
      "$helper" -S --needed "$package"
      list=aur
    fi

    sed -i "/^${package}\$/d" "$DOTFILES/packages/ignore.txt"
    if ! listed_packages | grep -qx -- "$package"; then
      printf '%s\n' "$package" >>"$DOTFILES/packages/$list.txt"
      log "Recorded $package in packages/$list.txt"
    fi
  done
}

cmd_pkg() {
  case "${1:-}" in
    add) shift; cmd_pkg_add "$@" ;;
    drift) drift_packages ;;
    ignore)
      shift
      [[ $# -gt 0 ]] || die "Usage: dot pkg ignore <package>..."
      printf '%s\n' "$@" >>"$DOTFILES/packages/ignore.txt"
      ;;
    *) die "Usage: dot pkg add | drift | ignore" ;;
  esac
}

DOCTOR_ISSUES=0

check_link() {
  local src="$1" dst="$2" short="${2/#"$HOME"/\~}"

  if [[ -L "$dst" && "$(readlink "$dst")" == "$src" ]]; then
    [[ -e "$dst" ]] && return 0
    warn "broken: $short points to a missing file"
  elif [[ -L "$dst" ]]; then
    warn "foreign: $short points to $(readlink "$dst")"
  elif [[ -e "$dst" ]]; then
    warn "copy: $short is a real file, not a link (run: dot sync)"
  else
    warn "missing: $short (run: dot sync)"
  fi
  DOCTOR_ISSUES=$((DOCTOR_ISSUES + 1))
}

check_packages() {
  command_exists pacman || return 0

  local package
  while read -r package; do
    pacman -Q "$package" >/dev/null 2>&1 && continue
    warn "package not installed: $package"
    DOCTOR_ISSUES=$((DOCTOR_ISSUES + 1))
  done < <(grep -hEv '^\s*(#|$)' "$DOTFILES/packages/arch.txt" "$DOTFILES/packages/aur.txt")

  local drift
  drift="$(drift_packages | wc -l)"
  if ((drift > 0)); then
    warn "$drift package(s) installed but not in packages/ (run: dot pkg drift)"
    DOCTOR_ISSUES=$((DOCTOR_ISSUES + 1))
  fi
}

cmd_doctor() {
  local manifest
  while read -r manifest; do
    each_link "$manifest" check_link
  done < <(manifests)

  [[ "${1:-}" == "links" ]] || check_packages

  if ((DOCTOR_ISSUES == 0)); then
    log "Everything in place"
  else
    die "$DOCTOR_ISSUES issue(s) found"
  fi
}

case "${1:-}" in
  sync) cmd_sync ;;
  save) shift; cmd_save "$@" ;;
  edit) shift; cmd_edit "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  pkg) shift; cmd_pkg "$@" ;;
  secret) shift; "$DOTFILES/scripts/secrets.sh" "$@" ;;
  -h | --help | help | "") usage ;;
  *) usage; exit 1 ;;
esac
